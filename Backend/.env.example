# GrindOS Backend Configuration
DATABASE_URL=sqlite:///./grindos.db
# Or PostgreSQL: postgresql://user:password@localhost:5432/grindos
SECRET_KEY=change-this-to-a-secure-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GEMINI_API_KEY=your-gemini-api-key

# Neo4j AuraDB Configuration (Career Navigator & Graph Intelligence)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j
